# Names only. Values never go in this repo: credentials live in n8n's credential store.

# n8n process environment (set where n8n starts)
NODE_FUNCTION_ALLOW_BUILTIN=        # must include: crypto,zlib  (src/steps.js hashing, src/docx.js)
N8N_USER_FOLDER=                    # e.g. the N1 instance folder

# Entered into n8n credentials, not read by the workflow from the environment
GOOGLE_OAUTH_CLIENT_ID=             # n8n credential "google-drive-lab" (Google Drive OAuth2 API)
GOOGLE_OAUTH_CLIENT_SECRET=         # same client can back "gmail-lab" (Gmail OAuth2)
HUBSPOT_SERVICE_KEY=                # n8n credential "hubspot-demo" (HubSpot App Token)
ANTHROPIC_API_KEY=                  # n8n credential "anthropic-lab" (Anthropic API)

# Optional: alert webhook URL goes in the config node's alertWebhookUrl, not here
